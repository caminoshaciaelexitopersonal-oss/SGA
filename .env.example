# --- CONFIGURACIÓN DE ENTORNOS Y SECRETOS SGA-CD (.env.example) ---
# Copia este archivo a .env e inyecta tus credenciales reales antes de arrancar.

# --- Core Security & Database ---
SECRET_KEY="SU_SECRET_KEY_SEGURO_DE_256_BITS_AQUI"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL="sqlite:///SGA-CD-DB.git/sga_cd_main.db"

# --- OpenAI API (Servicios de Inteligencia Artificial) ---
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY_HERE"

# --- Stripe (Pasarela de Pago) ---
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"
STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# --- Mercado Pago (Pasarela de Pago) ---
MERCADOPAGO_ACCESS_TOKEN="TEST-YOUR_MERCADOPAGO_ACCESS_TOKEN"

# --- Wompi (Pasarela de Pago) ---
WOMPI_PUBLIC_KEY="pub_test_YOUR_WOMPI_PUBLIC_KEY"
WOMPI_SECRET_KEY="prv_test_YOUR_WOMPI_SECRET_KEY"

# --- WhatsApp API ---
WHATSAPP_API_TOKEN="YOUR_WHATSAPP_API_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_VERIFY_TOKEN="sga-cd-whatsapp-verify-token"

# --- Meta (Facebook/Instagram OAuth) ---
META_CLIENT_ID="YOUR_META_APP_ID"
META_CLIENT_SECRET="YOUR_META_APP_SECRET"

# --- Google Workspace OAuth ---
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# --- Host / Callback Base URL ---
SERVER_HOST="http://localhost:8000"
