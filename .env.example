# Variables de Entorno para la Orquestación SGA-CD (Fase 7C)
# Copiar este archivo como .env en la raíz para entorno local/despliegue.

# Base de Datos PostgreSQL
POSTGRES_DB=sgacd_db
POSTGRES_USER=sgacd_user
POSTGRES_PASSWORD=sgacd_secure_password_2025

# Backend FastAPI
DATABASE_URL=postgresql://sgacd_user:sgacd_secure_password_2025@postgres:5432/sgacd_db
SECRET_KEY=sgacd_jwt_secret_key_change_in_production_2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_V1_STR=/api/v1
PROJECT_NAME="SGA-CD API Backend"

# Configuración de Conectividad para Clientes (Web / Desktop / Mobile)
# Para desarrollo local en host: http://localhost:8000
# Para comunicación inter-contenedor Docker: http://fastapi-backend:8000
# Para emulador Android/Dispositivo Móvil: http://10.0.2.2:8000 o IP de red local
API_BASE_URL=http://localhost:8000
TENANT_API_KEY=sgacd_default_tenant_key
